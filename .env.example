# Supabase — public values (the anon key is meant to ship in the browser; row-level security guards the data).
# Local dev: copy to .env.local (git-ignored). Vercel: Project → Settings → Environment Variables, or let the
# Vercel–Supabase integration inject SUPABASE_URL / SUPABASE_ANON_KEY (also accepted).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key
